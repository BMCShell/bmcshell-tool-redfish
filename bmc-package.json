{
  "schema": 1,
  "id": "15b746d7-7b0d-4556-89c8-d88078a3117a",
  "type": "toolplugin",
  "publisher": "bmcshell",
  "shortName": "redfish",
  "name": "bmcshell-tool-redfish",
  "displayName": "BMCShell Redfish",
  "description": "对当前目标执行 Redfish 请求，支持 JSON 和请求体文件。",
  "summary": "对当前目标执行 Redfish 请求，支持 JSON 和请求体文件。",
  "version": "1.0.4",
  "repository": "https://github.com/BMCShell/bmcshell-tool-redfish",
  "coreApi": 1,
  "platforms": [
    "windows-amd64"
  ],
  "help": "help.json",
  "changelog": "changelog.json",
  "settings": [
    {
      "key": "connect_timeout",
      "path": "tools.redfish",
      "label": "连接超时（秒）",
      "hint": "限制每次 Redfish 请求建立连接的时间。",
      "type": "integer",
      "default": 5,
      "min": 1,
      "max": 999,
      "env": "BMCSHELL_REDFISH_CONNECT_TIMEOUT"
    },
    {
      "key": "request_timeout",
      "path": "tools.redfish",
      "label": "请求超时（秒）",
      "hint": "限制每次 Redfish 请求完成的总时间。",
      "type": "integer",
      "default": 15,
      "min": 1,
      "max": 999,
      "env": "BMCSHELL_REDFISH_REQUEST_TIMEOUT"
    },
    {
      "key": "ca_bundle",
      "path": "tools.redfish",
      "label": "CA 证书文件",
      "hint": "开启 TLS 校验时，curl 使用指定的 PEM 证书文件。留空时使用默认信任配置。",
      "type": "string",
      "default": "",
      "env": "BMCSHELL_REDFISH_CA_BUNDLE"
    }
  ],
  "repairSuggestions": "repair.json",
  "assets": [
    "repair.json",
    "tool/compat/common.sh",
    "tool/compat/redfish.sh",
    "tool/compat/transport.sh",
    "tool/compat/input.sh",
    "tool/compat/auth.sh"
  ],
  "provides": {
    "tools": {
      "redfish": {
        "scope": "session",
        "runtime": "bash",
        "entry": "tool/entry.sh",
        "requires": [
          "target.ip"
        ]
      }
    }
  },
  "systemDependencies": [
    {
      "id": "curl"
    }
  ]
}
